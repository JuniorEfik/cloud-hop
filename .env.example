# Shared NEAR Testnet configuration
NEAR_NETWORK_ID=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_EXPLORER_URL=https://testnet.nearblocks.io
NEAR_INDEXER_URL=https://api-testnet.nearblocks.io
NEAR_CONTRACT_ID=near-arcade-contract-bf1dd35d6d.testnet
# Server-only deployment key for the funded Testnet contract account.
NEAR_CONTRACT_PRIVATE_KEY=

# Public Google / NEAR Auth configuration (safe for the browser bundle)
NEAR_FAST_AUTH_CLIENT_ID=np8paqIpMWmNbzT4xAvOOapZBjsOpptl
NEAR_FAST_AUTH_CONTRACT_ID=fast-auth.testnet
NEAR_MPC_CONTRACT_ID=v1.signer-prod.testnet

# Server-only account-creation sponsor. Never prefix these with PUBLIC_ and
# never expose them to the browser. The account must be the direct parent of
# generated player subaccounts and must hold enough Testnet NEAR.
NEAR_SPONSOR_ACCOUNT_ID=
NEAR_SPONSOR_PRIVATE_KEY=
NEAR_SPONSOR_INITIAL_BALANCE_NEAR=0.05
NEAR_SPONSOR_GAS_KEY_ALLOWANCE_NEAR=0.05
NEAR_SPONSOR_DAILY_LIMIT=100
NEAR_SPONSOR_PER_IP_DAILY_LIMIT=3

# Server-only meta-transaction relayer. This account pays gas for validated
# delegated actions; never expose its private key to the browser.
NEAR_RELAYER_ACCOUNT_ID=
NEAR_RELAYER_PRIVATE_KEY=
NEAR_RELAYER_PER_IP_MINUTE_LIMIT=20
NEAR_RELAYER_PER_ACCOUNT_MINUTE_LIMIT=10
NEAR_RELAYER_DAILY_LIMIT=500
NEAR_RELAYER_MAX_BLOCK_TTL=1000

# Server-only replay verifier. This secp256k1 key can attest deterministic
# scores only; players must still submit attestations from their own wallet.
NEAR_VERIFIER_PRIVATE_KEY=
NEAR_VERIFIER_ATTESTATION_TTL_SECONDS=120
NEAR_VERIFIER_PER_IP_MINUTE_LIMIT=30

# Local services
API_HOST=127.0.0.1
API_PORT=8787
WEB_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
PUBLIC_API_BASE_URL=http://127.0.0.1:8787
